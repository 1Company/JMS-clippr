// Clippr - Salon Booking Platform
// Database Schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================
// AUTHENTICATION & USERS
// ============================================

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  name          String?
  phone         String?
  emailVerified DateTime?
  image         String?
  role          UserRole  @default(CUSTOMER)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // Relations
  accounts      Account[]
  sessions      Session[]
  
  // Als salon eigenaar
  ownedSalons   Salon[]   @relation("SalonOwner")
  
  // Als medewerker
  staffProfile  Staff?
  
  // Als klant
  customerBookings Booking[] @relation("CustomerBookings")
  
  @@index([email])
}

enum UserRole {
  CUSTOMER
  STAFF
  OWNER
  ADMIN
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ============================================
// SALON
// ============================================

model Salon {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique  // voor publieke URL: clippr.nl/book/[slug]
  description String?
  phone       String?
  email       String?
  website     String?
  logo        String?
  
  // Adres
  street      String?
  city        String?
  postalCode  String?
  country     String   @default("NL")
  
  // Settings
  timezone    String   @default("Europe/Amsterdam")
  currency    String   @default("EUR")
  bufferMinutes Int    @default(5)  // Buffer tussen afspraken
  
  // Status
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  // Relations
  ownerId     String
  owner       User     @relation("SalonOwner", fields: [ownerId], references: [id])
  
  staff           Staff[]
  services        Service[]
  serviceCategories ServiceCategory[]
  openingHours    OpeningHours[]
  closedDays      ClosedDay[]
  bookings        Booking[]
  customers       Customer[]
  
  @@index([slug])
  @@index([ownerId])
}

// ============================================
// STAFF (Medewerkers)
// ============================================

model Staff {
  id          String   @id @default(cuid())
  displayName String
  bio         String?
  image       String?
  phone       String?
  color       String?  // Voor agenda weergave
  sortOrder   Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  // Relations
  salonId     String
  salon       Salon    @relation(fields: [salonId], references: [id], onDelete: Cascade)
  
  userId      String?  @unique  // Optioneel: gekoppeld aan user account
  user        User?    @relation(fields: [userId], references: [id])
  
  // Wat kan deze medewerker
  services    StaffService[]
  
  // Werkrooster
  schedule    StaffSchedule[]
  
  // Afwezigheid
  vacations   Vacation[]
  sickLeaves  SickLeave[]
  
  // Afspraken
  bookings    Booking[]
  
  @@index([salonId])
  @@index([userId])
}

// Koppeling medewerker <-> behandeling
model StaffService {
  id          String   @id @default(cuid())
  
  // Optioneel: afwijkende duur/prijs voor deze medewerker
  customDuration  Int?     // In minuten, null = gebruik service default
  customPrice     Decimal? @db.Decimal(10, 2)
  
  staffId     String
  staff       Staff    @relation(fields: [staffId], references: [id], onDelete: Cascade)
  
  serviceId   String
  service     Service  @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  
  @@unique([staffId, serviceId])
  @@index([staffId])
  @@index([serviceId])
}

// Werkrooster per dag
model StaffSchedule {
  id          String   @id @default(cuid())
  dayOfWeek   Int      // 0=zondag, 1=maandag, ..., 6=zaterdag
  startTime   String   // "09:00"
  endTime     String   // "17:00"
  breakStart  String?  // "12:00"
  breakEnd    String?  // "12:30"
  isWorking   Boolean  @default(true)
  
  staffId     String
  staff       Staff    @relation(fields: [staffId], references: [id], onDelete: Cascade)
  
  @@unique([staffId, dayOfWeek])
  @@index([staffId])
}

// Vakanties
model Vacation {
  id          String   @id @default(cuid())
  startDate   DateTime @db.Date
  endDate     DateTime @db.Date
  reason      String?
  createdAt   DateTime @default(now())
  
  staffId     String
  staff       Staff    @relation(fields: [staffId], references: [id], onDelete: Cascade)
  
  @@index([staffId])
  @@index([startDate, endDate])
}

// Ziekmeldingen
model SickLeave {
  id              String    @id @default(cuid())
  startDate       DateTime  @db.Date
  endDate         DateTime? @db.Date  // null = nog niet bekend
  expectedReturn  DateTime? @db.Date
  notes           String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  
  staffId         String
  staff           Staff     @relation(fields: [staffId], references: [id], onDelete: Cascade)
  
  @@index([staffId])
}

// ============================================
// SERVICES (Behandelingen)
// ============================================

model ServiceCategory {
  id          String   @id @default(cuid())
  name        String   // "Knippen", "Kleuren", "Nagels"
  description String?
  sortOrder   Int      @default(0)
  
  salonId     String
  salon       Salon    @relation(fields: [salonId], references: [id], onDelete: Cascade)
  
  services    Service[]
  
  @@index([salonId])
}

model Service {
  id          String   @id @default(cuid())
  name        String   // "Dames knippen", "Heren knippen"
  description String?
  duration    Int      // In minuten
  price       Decimal  @db.Decimal(10, 2)
  isActive    Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime  @updatedAt
  
  // Relations
  salonId     String
  salon       Salon    @relation(fields: [salonId], references: [id], onDelete: Cascade)
  
  categoryId  String?
  category    ServiceCategory? @relation(fields: [categoryId], references: [id])
  
  // Welke medewerkers kunnen dit
  staff       StaffService[]
  
  // Boekingen
  bookings    Booking[]
  
  @@index([salonId])
  @@index([categoryId])
}

// ============================================
// OPENING HOURS & CLOSED DAYS
// ============================================

// Standaard openingstijden per dag
model OpeningHours {
  id          String   @id @default(cuid())
  dayOfWeek   Int      // 0=zondag, 1=maandag, ..., 6=zaterdag
  openTime    String   // "09:00"
  closeTime   String   // "17:00"
  isClosed    Boolean  @default(false)
  
  salonId     String
  salon       Salon    @relation(fields: [salonId], references: [id], onDelete: Cascade)
  
  @@unique([salonId, dayOfWeek])
  @@index([salonId])
}

// Speciale gesloten dagen (feestdagen, etc.)
model ClosedDay {
  id          String   @id @default(cuid())
  date        DateTime @db.Date
  reason      String?  // "Kerst", "Verbouwing"
  
  salonId     String
  salon       Salon    @relation(fields: [salonId], references: [id], onDelete: Cascade)
  
  @@unique([salonId, date])
  @@index([salonId])
}

// ============================================
// CUSTOMERS (Klanten)
// ============================================

model Customer {
  id                  String   @id @default(cuid())
  email               String
  name                String
  phone               String?
  notes               String?  // "Wil altijd thee"
  
  // Voorkeur
  preferredStaffId    String?
  
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
  
  // Relations
  salonId             String
  salon               Salon    @relation(fields: [salonId], references: [id], onDelete: Cascade)
  
  bookings            Booking[] @relation("SalonCustomerBookings")
  
  @@unique([salonId, email])  // Uniek per salon
  @@index([salonId])
  @@index([email])
}

// ============================================
// BOOKINGS (Afspraken)
// ============================================

model Booking {
  id          String        @id @default(cuid())
  startTime   DateTime
  endTime     DateTime
  status      BookingStatus @default(CONFIRMED)
  notes       String?
  
  // Pricing at time of booking
  price       Decimal       @db.Decimal(10, 2)
  duration    Int           // In minuten
  
  // Bron van boeking
  source      BookingSource @default(ONLINE)
  
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  cancelledAt DateTime?
  cancelReason String?
  
  // Relations
  salonId     String
  salon       Salon         @relation(fields: [salonId], references: [id], onDelete: Cascade)
  
  serviceId   String
  service     Service       @relation(fields: [serviceId], references: [id])
  
  staffId     String
  staff       Staff         @relation(fields: [staffId], references: [id])
  
  // Klant (salon-specific record)
  customerId  String?
  customer    Customer?     @relation("SalonCustomerBookings", fields: [customerId], references: [id])
  
  // Of direct user (als ingelogd)
  userId      String?
  user        User?         @relation("CustomerBookings", fields: [userId], references: [id])
  
  // Guest booking info (als niet ingelogd)
  guestName   String?
  guestEmail  String?
  guestPhone  String?
  
  @@index([salonId])
  @@index([staffId])
  @@index([customerId])
  @@index([startTime])
  @@index([status])
}

enum BookingStatus {
  PENDING     // Wacht op bevestiging
  CONFIRMED   // Bevestigd
  CANCELLED   // Geannuleerd
  NO_SHOW     // Niet komen opdagen
  COMPLETED   // Afgerond
}

enum BookingSource {
  ONLINE      // Via publieke booking pagina
  ADMIN       // Handmatig door beheerder
  PHONE       // Telefonisch
  WALK_IN     // Inloop
}
